# Public example config. Copy to .env and fill in your own OpenAI-compatible API settings.
CC_AGENT_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# Agent runtime limits
CC_AGENT_MAX_STEPS=8
CC_AGENT_COMMAND_TIMEOUT=60
CC_AGENT_TRACE_DIR=traces

# Repository RAG. The embedding settings fall back to OPENAI_API_KEY / OPENAI_BASE_URL.
CC_AGENT_RETRIEVAL_MODE=hybrid
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_API_KEY=sk-your-embedding-api-key
# RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAG_INDEX_DIR=~/.cache/cc-agent/rag
RAG_EMBEDDING_BATCH_SIZE=64
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP_LINES=5
RAG_CANDIDATE_MULTIPLIER=4
RAG_RRF_K=60
RAG_IDENTIFIER_BOOST=0.03
RAG_CONTEXT_MAX_TOKENS=2000
RAG_RERANKER=heuristic
RAG_RERANK_WEIGHT=0.02
RAG_GIT_CHANGE_BOOST=0.02
